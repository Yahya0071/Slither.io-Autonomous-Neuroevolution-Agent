{
  "manifest_version": 3,
  "name": "Slither.io Machine Learning Agent",
  "version": "5.10.6",
  "description": "Deep Neural Network & Evolutionary Reinforcement Learning Agent for the real Slither.io game with real-time HUD telemetry and raycasting.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "*://slither.io/*",
    "*://slither.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://slither.io/*",
        "*://slither.com/io*",
        "*://*.slither.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["agent.js"],
      "matches": [
        "*://slither.io/*",
        "*://slither.com/*"
      ]
    }
  ]
}
